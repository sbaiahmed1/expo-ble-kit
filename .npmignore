# Exclude all top-level hidden files and directories by convention
/.*

# Exclude nested package ignore files
**/.gitignore
**/.npmignore

# Exclude TypeScript project configuration and incremental build caches
**/tsconfig.json
**/tsconfig.all.json
**/*.tsbuildinfo

# Exclude monorepo build configuration
/turbo.json

# Exclude test configuration
**/jest.config.*
**/jest.setup.*
**/jest-setup.*

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/DEVELOPMENT.md

/babel.config.js
/internal/
/android/src/androidTest/**
/android/src/test/**
/android/build/**
/example/

# Repo-only material (plan, agent notes, test peripherals, lint config)
/docs/
/AGENTS.md
/test-peripherals/
/e2e/
/eslint.config.cjs
/CONTRIBUTING.md
/SECURITY.md
/ios/Package.swift
/ios/Tests/
/ios/.build/
**/.swiftpm/
