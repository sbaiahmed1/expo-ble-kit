  "NSBluetoothAlwaysUsageDescription": "Allow $(PRODUCT_NAME) to use Bluetooth to connect to nearby devices.",
  "UIBackgroundModes": [
    "audio",
    "bluetooth-peripheral",
  ],
}
`;

