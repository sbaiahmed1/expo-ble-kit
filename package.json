{
  "name": "expo-ble-kit",
  "version": "0.1.1",
  "description": "Bluetooth Low Energy toolkit for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./build/testing/index.d.ts",
      "default": "./build/testing/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "build/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "build:plugin": "node internal/module_scripts/build.js plugin",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "lint:native": "swiftlint lint --strict && ktlint \"android/src/**/*.kt\" \"benchmarks/android-reference/app/src/**/*.kt\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"plugin/src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin",
    "check:package": "node internal/check-package-contents.js",
    "docs": "typedoc",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "changeset": "changeset",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "prepublishOnly": "node internal/check-publish-tag.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "bluetooth",
    "ble",
    "bluetooth-low-energy",
    "expo-ble-kit",
    "ExpoBleKit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbaiahmed1/expo-ble-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sbaiahmed1/expo-ble-kit/issues"
  },
  "author": "Ahmed Sbai <ahmedclubust@gmail.com> (https://github.com/sbaiahmed1)",
  "license": "MIT",
  "homepage": "https://github.com/sbaiahmed1/expo-ble-kit#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@changesets/cli": "^3.0.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.2.1",
    "@types/node": "^24.18.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.0.0",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "test-renderer": "~1.2.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "passWithNoTests": true
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "yarn@4.18.1"
}
